<section class="ms-shop-content">
  <div class="ms-shop-header">{{#if npcImg}}<img class="ms-shop-portrait" src="{{npcImg}}" alt="{{npcName}}">{{/if}}
    <div><h2>{{npcName}}</h2><p>{{ownerName}} · {{actorName}}</p>
      {{#if readOnly}}<p class="ms-note">{{dmicherScreenText "Мастер наблюдает за предложением участника. Решение об обмене доступно в чате и панели магазинов." "The GM is viewing the participant's offer. Approve or reject the trade in chat or the Shops panel."}}</p>{{/if}}</div>
    <div class="ms-actions"><button type="button" data-action="refresh">{{dmicherScreenText "Обновить" "Refresh"}}</button><button type="button" data-action="sheet">{{dmicherScreenText "Лист персонажа" "Character sheet"}}</button></div>
  </div>
  {{#if unavailable}}<p class="ms-status">{{unavailable}}</p>{{/if}}
  {{#if feedback}}<p class="ms-status" role="status">{{feedback}}</p>{{/if}}
  {{#unless unavailable}}
    <section class="ms-shop-catalog"><div class="ms-toolbar"><h3>{{dmicherScreenText "Ассортимент" "Catalog"}}</h3><button type="button" data-action="display" data-view="list">{{dmicherScreenText "Список" "List"}}</button><button type="button" data-action="display" data-view="tiles">{{dmicherScreenText "Плитки" "Tiles"}}</button></div>
      {{#each groups}}<details open><summary>{{name}}</summary><ul class="ms-list {{#if ../tiles}}ms-shop-tiles{{/if}}">
        {{#each items}}<li draggable="true" data-stock-drag="{{id}}"><img src="{{img}}" alt="" width="40" height="40"><span>{{name}}</span><span>{{dmicherScreenText "Остаток" "Stock"}}: {{stock}}</span><button type="button" data-action="addTake" data-entry-id="{{id}}" {{#if unavailable}}disabled{{/if}}>{{dmicherScreenText "В предложение" "Add to offer"}}</button></li>{{/each}}
      </ul></details>{{else}}<p>{{dmicherScreenText "Ассортимент пуст." "The catalog is empty."}}</p>{{/each}}
    </section>
    <section class="ms-shop-exchange"><h3>{{dmicherScreenText "Предложение обмена" "Trade offer"}}</h3><p class="ms-note">{{dmicherScreenText "Перетаскивание и кнопки меняют только предложение. Передача произойдёт после подтверждения всего обмена." "Dragging and buttons only change the offer. Items transfer after the entire trade is confirmed."}} {{#if needsApproval}}{{dmicherScreenText "Мастер должен одобрить предложение." "The GM must approve the offer."}}{{/if}}</p>
      <div class="ms-shop-columns">
        <section data-offer-drop="player"><h4>{{dmicherScreenText "Персонаж отдаёт" "Character gives"}}</h4><ul class="ms-list">
          {{#each offeredGive}}<li><img src="{{img}}" alt="" width="32" height="32"><span>{{name}}</span><button type="button" data-action="removeGive" data-item-id="{{id}}" {{#if locked}}disabled{{/if}}>{{dmicherScreenText "Убрать" "Remove"}}</button></li>{{else}}<li>{{dmicherScreenText "Перенесите предметы из листа персонажа." "Drop items from the character sheet."}}</li>{{/each}}
        </ul><details><summary>{{dmicherScreenText "Добавить из инвентаря" "Add from inventory"}}</summary><ul class="ms-list">{{#each inventory}}<li><span>{{name}}</span><button type="button" data-action="addGive" data-item-id="{{id}}" {{#if locked}}disabled{{/if}}>{{dmicherScreenText "Добавить" "Add"}}</button></li>{{/each}}</ul></details></section>
        <section data-offer-drop="npc"><h4>{{dmicherScreenText "Персонаж получает" "Character receives"}}</h4><ul class="ms-list">
          {{#each offeredTake}}<li><img src="{{img}}" alt="" width="32" height="32"><span>{{name}} × {{count}}</span><button type="button" data-action="removeTake" data-entry-id="{{id}}" {{#if locked}}disabled{{/if}}>−1</button></li>{{else}}<li>{{dmicherScreenText "Перенесите предметы из ассортимента." "Drop items from the catalog."}}</li>{{/each}}
        </ul></section>
      </div>
      <div data-currency-adapter hidden></div>
      <p class="ms-note">{{dmicherScreenText "Цены и валюты ещё не подключены. Каждый предмет передаётся целиком, с системными данными и содержимым стопки. Остаток магазина — число таких предметов." "Prices and currencies are not connected yet. Each item transfers as a whole, including its system data and stack contents. Shop stock counts these whole items."}}</p>
      <div class="ms-actions"><button type="button" data-action="confirm" {{#if confirmDisabled}}disabled{{/if}}>{{dmicherScreenText "Подтвердить предложение" "Confirm offer"}}</button>{{#if finished}}<button type="button" data-action="newOffer">{{dmicherScreenText "Новый обмен" "New trade"}}</button>{{/if}}</div>
    </section>
  {{/unless}}
</section>
