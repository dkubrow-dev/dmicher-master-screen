<section class="ms-body ms-shops-manager-content">
  {{#if unavailable}}<p class="ms-note">Откройте сцену под учётной записью мастера.</p>{{else}}
  <header class="ms-toolbar"><div><h2>Магазины сцены</h2><span class="ms-note">{{sceneName}}</span></div><button type="button" data-shop-manager-action="refresh"><i class="fa-solid fa-rotate"></i> Обновить</button></header>
  <p class="ms-note">Один магазин обслуживает одного участника за раз. Мастер может присоединиться к его сессии, рассмотреть обмен или освободить магазин.</p>
  <div class="ms-shops-cards">
    {{#each shops}}
    <article class="ms-shop-manager-card">
      <div class="ms-toolbar">
        <div class="ms-token-title">{{#if img}}<img src="{{img}}" alt="" class="ms-shop-portrait">{{/if}}<div><strong>{{npcName}}</strong><small class="ms-note">{{groupName}} · {{status}}</small></div></div>
        <span class="ms-shop-badge {{#if occupied}}is-occupied{{/if}}">{{#unless enabled}}Недоступен{{else}}{{#if occupied}}Занят{{else}}Свободен{{/if}}{{/unless}}</span>
      </div>
      {{#if session}}
      <div class="ms-session-info"><span>Игрок: <strong>{{session.userName}}</strong></span><span>Персонаж: <strong>{{session.actorName}}</strong></span>{{#if expiresText}}<span class="ms-note">Сессия до {{expiresText}}</span>{{/if}}</div>
      <div class="ms-actions"><button type="button" data-shop-manager-action="join" data-shop-id="{{shopId}}" data-token-id="{{tokenId}}" data-group-id="{{groupId}}" data-session-id="{{session.id}}" {{#if expired}}disabled{{/if}}><i class="fa-solid fa-eye"></i> Присоединиться</button><button type="button" data-shop-manager-action="release" data-shop-id="{{shopId}}" data-token-id="{{tokenId}}" data-group-id="{{groupId}}" data-session-id="{{session.id}}">Освободить магазин</button></div>
      {{/if}}
      {{#each pending}}
      <div class="ms-pending-exchange">
        <strong>Предложение обмена</strong>
        <p><span class="ms-note">Игрок отдаёт:</span> {{#if summary.give}}{{summary.give}}{{else}}ничего{{/if}}<br><span class="ms-note">Игрок получает:</span> {{#if summary.take}}{{summary.take}}{{else}}ничего{{/if}}</p>
        {{#if actionable}}<div class="ms-actions"><button type="button" data-shop-manager-action="approve" data-shop-id="{{../shopId}}" data-token-id="{{../tokenId}}" data-group-id="{{../groupId}}" data-message-id="{{messageId}}" class="ms-primary">Подтвердить обмен</button><button type="button" data-shop-manager-action="reject" data-shop-id="{{../shopId}}" data-token-id="{{../tokenId}}" data-group-id="{{../groupId}}" data-message-id="{{messageId}}" class="ms-danger">Отклонить</button></div>{{else}}<p class="ms-note">Статус: {{status}}</p>{{/if}}
      </div>
      {{/each}}
      {{#each issues}}<div class="ms-pending-exchange ms-error" role="status"><strong>{{statusLabel}}</strong><p>Игрок отдаёт: {{summary.give}}<br>Игрок получает: {{summary.take}}</p>{{#if error}}<p>{{error}}</p>{{/if}}</div>{{/each}}
    </article>
    {{else}}<p class="ms-status">В этой сцене ещё нет магазинов. В конструкторе откройте настройки НИП и включите магазин в нужном состоянии.</p>{{/each}}
  </div>
  {{/if}}
</section>
