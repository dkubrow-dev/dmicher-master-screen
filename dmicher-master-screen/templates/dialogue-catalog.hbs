<section class="ms-body">
  {{#if missing}}<p class="ms-note">{{#if missingGroup}}{{dmicherScreenText "Создайте диалог в «Инструменты → Диалоги» и назначьте его объектам." "Create a dialogue in Tools → Dialogues and assign it to objects."}}{{else}}{{dmicherScreenText "Откройте сцену под учётной записью мастера." "Open a scene as a GM."}}{{/if}}</p>{{else}}
  <header class="ms-toolbar"><h2>{{dmicherScreenText "Диалоги и действия" "Dialogues and actions"}}</h2><span class="ms-note">{{sceneName}}</span></header>
  <p class="ms-status">{{dmicherScreenText "Ручной показ: ответы не испускают сигналы и не запускают автоматизацию. Каталог доступен даже после полной остановки сцены." "Manual display: responses do not emit signals or start automation. The catalog remains available after a complete scene stop."}}</p>
  <div class="ms-state-tabs">{{#each dialogues}}<button type="button" data-catalog-action="select" data-dialogue-id="{{id}}" class="{{#if selected}}is-selected{{/if}}">{{name}}</button>{{else}}<p class="ms-note">{{dmicherScreenText "Создайте диалог в «Инструменты → Диалоги»." "Create a dialogue in Tools → Dialogues."}}</p>{{/each}}</div>
  {{#if dialogue}}
  <section class="ms-section"><h3>{{dialogue.name}}</h3>
    <label class="ms-field">{{dmicherScreenText "Блок для просмотра" "Page to view"}}<select name="catalogPage">{{selectOptions pages selected=page.id valueAttr="id" labelAttr="label"}}</select></label>
    {{#if page.art}}<img src="{{page.art}}" alt="" class="ms-dialogue-art">{{/if}}<p class="ms-dialogue-text">{{page.text}}</p>
    <div class="ms-list">{{#each page.responses}}<div class="ms-status"><strong>{{label}}</strong><p class="ms-note">{{#if nextPageId}}{{dmicherScreenText "Продолжение" "Continue to"}}: {{nextPageId}}{{else}}{{dmicherScreenText "Завершение разговора" "Finish conversation"}}{{/if}}{{#if signalId}} · {{dmicherScreenText "Сигнал" "Signal"}} {{signalId}} {{dmicherScreenText "только как справка; при ручном показе не выполняется" "for reference only; not emitted during manual display"}}{{/if}}</p></div>{{/each}}</div>
    <div class="ms-actions"><button type="button" data-catalog-action="self">{{dmicherScreenText "Открыть диалог себе" "Open dialogue for yourself"}}</button></div>
    <h3>{{dmicherScreenText "Показать игрокам" "Show to players"}}</h3><div class="ms-actions">{{#each players}}<label class="ms-check"><input name="catalogRecipient" type="checkbox" value="{{id}}" {{checked selected}}> {{name}}{{#unless active}} · {{dmicherScreenText "не подключён" "offline"}}{{/unless}}</label>{{else}}<p class="ms-note">{{dmicherScreenText "В мире нет учётных записей игроков." "This world has no player accounts."}}</p>{{/each}}</div><button type="button" data-catalog-action="players" class="ms-primary">{{dmicherScreenText "Показать выбранным игрокам" "Show to selected players"}}</button>
  </section>
  {{/if}}
  <details class="ms-details"><summary>{{dmicherScreenText "Прямые действия · справочник мастера" "Direct actions · GM reference"}}</summary><p class="ms-note">{{dmicherScreenText "Просмотр настроек не выполняет действие." "Viewing settings does not run the action."}}</p>{{#each actions}}<div class="ms-config-row"><strong>{{name}}</strong><p>{{dmicherScreenText "Объект" "Object"}}: {{targetName}} · {{dmicherScreenText "Сигнал:" "Signal:"}} <code>{{signalId}}</code></p><p class="ms-note">{{#if enabled}}{{dmicherScreenText "Подготовлено к работе в состоянии" "Prepared for this state"}}{{else}}{{dmicherScreenText "Выключено" "Disabled"}}{{/if}} · {{dmicherScreenText "Дальность" "Range"}} {{range}}</p></div>{{else}}<p class="ms-note">{{dmicherScreenText "Прямых действий нет." "No direct actions."}}</p>{{/each}}</details>
  {{/if}}
</section>
